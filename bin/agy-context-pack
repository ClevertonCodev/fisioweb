#!/usr/bin/env bash
# Monta agy-context.md para jobs Antigravity (paridade com regras do fisioweb).
# Uso: bin/agy-context-pack --task <tasks/NNN.md> --out-dir <evidence/dir>
set -euo pipefail

usage() {
    cat <<'EOF'
Uso: bin/agy-context-pack --task <arquivo.md> --out-dir <pasta>

Gera <out-dir>/agy-context.md com núcleo de regras, AGENTS.md, texto da tarefa
e skills do projeto conforme .agy/skills-manifest.json.

Opções:
  --task <path>     Arquivo de tarefa (obrigatório)
  --out-dir <path>  Pasta de destino (obrigatório)
  --help            Esta ajuda
EOF
}

TASK_FILE=""
OUT_DIR=""

while [ $# -gt 0 ]; do
    case "$1" in
        --task)
            TASK_FILE="${2:-}"
            shift 2
            ;;
        --out-dir)
            OUT_DIR="${2:-}"
            shift 2
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Opção desconhecida: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -z "$TASK_FILE" ] || [ -z "$OUT_DIR" ]; then
    echo "FALHOU: --task e --out-dir são obrigatórios." >&2
    usage >&2
    exit 2
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "FALHOU: execute na raiz do repositório git." >&2
    exit 1
}
cd "$ROOT"

if [ ! -f "$TASK_FILE" ]; then
    echo "FALHOU: tarefa não encontrada: $TASK_FILE" >&2
    exit 1
fi

MANIFEST="$ROOT/.agy/skills-manifest.json"
CORE="$ROOT/docs/ai-harness/agy-context-core.md"
AGENTS="$ROOT/AGENTS.md"
SKILLS_ROOT="$ROOT/.cursor/skills"

for f in "$MANIFEST" "$CORE" "$AGENTS"; do
    if [ ! -f "$f" ]; then
        echo "FALHOU: arquivo obrigatório ausente: $f" >&2
        exit 1
    fi
done

mkdir -p "$OUT_DIR"
OUT_FILE="$OUT_DIR/agy-context.md"

TAGS_SCRIPT="$ROOT/bin/agy-context-pack-tags.py"
if [ ! -f "$TAGS_SCRIPT" ]; then
    echo "FALHOU: $TAGS_SCRIPT ausente." >&2
    exit 1
fi
SKILL_LIST="$(python3 "$TAGS_SCRIPT" "$MANIFEST" "$TASK_FILE" "$SKILLS_ROOT")"

{
    echo "# Pacote de contexto agy — fisioweb"
    echo
    echo "_Gerado por bin/agy-context-pack em $(date '+%Y-%m-%d %H:%M:%S %z')_"
    echo
    echo "## Tarefa"
    echo
    echo '~~~markdown'
    cat "$TASK_FILE"
    echo '~~~'
    echo
    echo "## Núcleo de regras (always-on)"
    echo
    cat "$CORE"
    echo
    echo "## AGENTS.md"
    echo
    cat "$AGENTS"
    echo
    echo "## Skills do projeto (anexos)"
    echo
    if [ -z "$SKILL_LIST" ]; then
        echo "_Nenhuma skill resolvida; confira .agy/skills-manifest.json_"
    else
        while IFS= read -r skill; do
            [ -z "$skill" ] && continue
            skill_file="$SKILLS_ROOT/$skill/SKILL.md"
            echo "### Skill: $skill"
            echo
            cat "$skill_file"
            echo
        done <<< "$SKILL_LIST"
    fi
} >"$OUT_FILE"

echo "OK: $OUT_FILE ($(wc -c <"$OUT_FILE" | tr -d ' ') bytes, skills: $(echo "$SKILL_LIST" | grep -c . || echo 0))"
