#!/usr/bin/env bash
# Harness Antigravity (agy) para o fisioweb — jobs locais, sem túnel.
set -euo pipefail

AGY_MIN_VERSION="1.1.0"
MODEL_OPUS="claude-opus-5-5-high"
MODEL_ARGON="gemini-4-argon-high"
ANTIGRAVITY_CLI_HOME="${ANTIGRAVITY_CLI_HOME:-$HOME/.gemini/antigravity-cli}"
DEFAULT_PRINT_TIMEOUT="30m"
MAX_FIX_ROUNDS=3

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=agy-task-lib.sh
source "$SCRIPT_DIR/agy-task-lib.sh"

usage() {
    cat <<'EOF'
Uso: bin/agy-task <comando> [opções]

Comandos:
  doctor              Verifica CLI, modelos, sessão e repositório
  start               Inicia job Antigravity (--task, --model, --background)
  verify <job-id>     npm run build + interpreta review.json do job
  fix-loop <job-id>   Reenvia correção ao agy (até 3 voltas no meta)
  status [job-id]     Status de um job ou lista recentes
  result [job-id]     Saída final / tail do log
  cancel <job-id>     Cancela job em background
  help                Esta ajuda

Documentação: docs/ai-harness/agy-task.md
EOF
}

record_ok() { echo "OK: $1"; }
record_fail() { echo "FALHOU: $1" >&2; }
record_warn() { echo "AVISO: $1" >&2; }

version_ge() {
    local have="$1"
    local want="$2"
    if [ "$have" = "$want" ]; then
        return 0
    fi
    local highest
    highest="$(printf '%s\n%s\n' "$want" "$have" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)"
    [ "$highest" = "$have" ]
}

validate_model() {
    local model="$1"
    case "$model" in
        "$MODEL_OPUS" | "$MODEL_ARGON") return 0 ;;
        *)
            record_fail "Modelo inválido: $model (use $MODEL_OPUS ou $MODEL_ARGON)"
            return 1
            ;;
    esac
}

cmd_doctor() {
    local failed=0
    local root
    if ! root="$(agy_task_root)"; then
        record_fail "Execute dentro de um repositório git (raiz do fisioweb)."
        return 1
    fi
    cd "$root"
    record_ok "Repositório git: $root"

    if [ ! -f "$root/AGENTS.md" ] || [ ! -f "$root/composer.json" ]; then
        record_fail "Não parece ser o fisioweb (faltam AGENTS.md ou composer.json)."
        failed=1
    else
        record_ok "Projeto fisioweb reconhecido"
    fi

    if ! agy_bin="$(agy_task_agy_bin 2>/dev/null)" || [ -z "$agy_bin" ]; then
        record_fail "agy não está no PATH. Instale: https://antigravity.google/docs/getting-started/"
        return 1
    fi
    record_ok "agy encontrado: $agy_bin"

    local agy_version
    agy_version="$("$agy_bin" --version 2>/dev/null | head -n 1 | tr -d '[:space:]')"
    if [ -z "$agy_version" ]; then
        record_fail "Não foi possível ler a versão do agy."
        failed=1
    elif ! version_ge "$agy_version" "$AGY_MIN_VERSION"; then
        record_fail "agy $agy_version é antigo; mínimo $AGY_MIN_VERSION."
        failed=1
    else
        record_ok "agy versão $agy_version (>= $AGY_MIN_VERSION)"
    fi

    if [ ! -d "$ANTIGRAVITY_CLI_HOME" ]; then
        record_fail "Pasta do CLI Antigravity ausente: $ANTIGRAVITY_CLI_HOME"
        failed=1
    else
        record_ok "Diretório Antigravity CLI: $ANTIGRAVITY_CLI_HOME"
    fi

    if [ -f "$ANTIGRAVITY_CLI_HOME/settings.json" ] || [ -f "$ANTIGRAVITY_CLI_HOME/jetski-standalone-oauth-token" ]; then
        record_ok "Indício de sessão Antigravity"
    else
        record_warn "Sem settings/token OAuth — faça login no agy se jobs falharem."
    fi

    if [ "${AGY_TASK_DRY_RUN:-}" = "1" ]; then
        record_warn "AGY_TASK_DRY_RUN=1 — modelos não conferidos."
    else
        local models_out
        if ! models_out="$("$agy_bin" models 2>&1)"; then
            record_fail "agy models falhou: ${models_out:0:200}"
            failed=1
        else
            echo "$models_out" | grep -q "$MODEL_OPUS" && record_ok "Modelo: $MODEL_OPUS" || {
                record_fail "Modelo $MODEL_OPUS ausente"
                failed=1
            }
            echo "$models_out" | grep -q "$MODEL_ARGON" && record_ok "Modelo: $MODEL_ARGON" || {
                record_fail "Modelo $MODEL_ARGON ausente"
                failed=1
            }
        fi
    fi

    if [ "$failed" -ne 0 ]; then
        return 1
    fi
    echo
    echo "Pronto para jobs agy-task neste repositório."
}

run_agy_prompt() {
    local job_dir="$1"
    local model="$2"
    local prompt_file="$3"
    local log_file="$4"
    local agy_bin
    agy_bin="$(agy_task_agy_bin)"

    if [ "${AGY_TASK_DRY_RUN:-}" = "1" ]; then
        echo "[DRY_RUN] agy -p <prompt> --model $model" | tee -a "$log_file"
        return 0
    fi

    cd "$(agy_task_root)"
    "$agy_bin" -p "$(cat "$prompt_file")" \
        --model "$model" \
        --mode accept-edits \
        --dangerously-skip-permissions \
        --print-timeout "${AGY_PRINT_TIMEOUT:-$DEFAULT_PRINT_TIMEOUT}" \
        2>&1 | tee -a "$log_file"
}

build_start_prompt() {
    local job_dir="$1"
    local out="$job_dir/prompt.txt"
    cat >"$out" <<EOF
You are implementing a task in the fisioweb repository (Laravel + React SaaS for physiotherapy clinics).

Before editing any file, read the full context package at this absolute path:
${job_dir}/agy-context.md

Follow every rule in that file (clinic_id isolation, modules/*, frontend layers, apiClient only).

Implement the task described in the context package. Edit files as needed.

Do NOT run git commit, git push, or read/commit .env or secrets.
Do NOT include real patient data in outputs.

When finished, summarize what you changed in plain language.
EOF
    echo "$out"
}

build_fix_prompt() {
    local job_dir="$1"
    local out="$job_dir/prompt-fix.txt"
    cat >"$out" <<EOF
You are fixing issues found in code review for fisioweb.

Read again: ${job_dir}/agy-context.md

Review findings (fix all critical, high, and medium):
$(cat "$job_dir/review.json")

Apply minimal safe fixes. Do not git commit or git push.
EOF
    echo "$out"
}

cmd_start() {
    local task_file=""
    local model=""
    local background=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --task)
                task_file="${2:-}"
                shift 2
                ;;
            --model)
                model="${2:-}"
                shift 2
                ;;
            --background)
                background=1
                shift
                ;;
            *)
                record_fail "Opção desconhecida: $1"
                return 2
                ;;
        esac
    done

    if [ -z "$task_file" ] || [ -z "$model" ]; then
        record_fail "start exige --task <arquivo.md> e --model <id>"
        return 2
    fi
    validate_model "$model" || return 1

    local root
    root="$(agy_task_root)" || return 1
    cd "$root"

    if [ "${AGY_TASK_SKIP_DOCTOR:-}" != "1" ]; then
        cmd_doctor || return 1
    fi

    local jobs_root
    jobs_root="$(agy_task_jobs_root)"
    mkdir -p "$jobs_root"

    local job_id
    job_id="$(agy_task_new_id)-$$"
    local job_dir="$jobs_root/$job_id"
    mkdir -p "$job_dir"

    if [ ! -f "$task_file" ]; then
        record_fail "Tarefa não encontrada: $task_file"
        return 1
    fi

    "$root/bin/agy-context-pack" --task "$task_file" --out-dir "$job_dir"

    python3 - "$job_dir/meta.json" "$job_id" "$task_file" "$model" "$job_dir" "$background" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, job_id, task, model, job_dir, bg = sys.argv[1:7]
data = {
    "id": job_id,
    "task_file": task,
    "model": model,
    "status": "running",
    "fix_rounds": 0,
    "max_fix_rounds": 3,
    "created_at": datetime.now(timezone.utc).isoformat(),
    "pid": None,
    "background": bg == "1",
    "job_dir": job_dir,
}
open(path, "w", encoding="utf-8").write(json.dumps(data, indent=2) + "\n")
PY

    ln -sfn "$job_dir" "$jobs_root/latest"

    local prompt_file
    prompt_file="$(build_start_prompt "$job_dir")"
    : >"$job_dir/agy.log"

    record_ok "Job $job_id em $job_dir"

    if [ "$background" -eq 1 ]; then
        (
            run_agy_prompt "$job_dir" "$model" "$prompt_file" "$job_dir/agy.log"
            agy_task_meta_set "$job_dir" status completed
        ) &
        local pid=$!
        agy_task_meta_set "$job_dir" pid "$pid"
        record_ok "Background pid $pid (bin/agy-task status $job_id)"
        return 0
    fi

    if run_agy_prompt "$job_dir" "$model" "$prompt_file" "$job_dir/agy.log"; then
        agy_task_meta_set "$job_dir" status completed
        record_ok "Job concluído. Próximo: bin/agy-task verify $job_id (após /agy-verify no Cursor)"
    else
        agy_task_meta_set "$job_dir" status failed
        return 1
    fi
}

cmd_verify() {
    local job_ref="${1:-}"
    local job_dir
    job_dir="$(agy_task_resolve_job_dir "$job_ref")" || return 1
    local root
    root="$(agy_task_root)"
    cd "$root"

    record_ok "Verify job: $(basename "$job_dir")"

    if ! npm run build >"$job_dir/build.log" 2>&1; then
        record_fail "npm run build falhou — veja $job_dir/build.log"
        agy_task_meta_set "$job_dir" last_verify build_failed
        return 1
    fi
    record_ok "npm run build passou"

    if [ ! -f "$job_dir/review.json" ]; then
        record_fail "review.json ausente. Rode /agy-verify no Cursor e salve em:"
        echo "  $job_dir/review.json" >&2
        return 2
    fi

    if python3 "$root/bin/agy-review-check.py" "$job_dir/review.json"; then
        agy_task_meta_set "$job_dir" last_verify pass
        record_ok "Portão verify: PASS"
        return 0
    fi
    agy_task_meta_set "$job_dir" last_verify fail
    record_fail "Portão verify: FAIL"
    return 1
}

cmd_fix_loop() {
    local job_ref="${1:-}"
    local job_dir
    job_dir="$(agy_task_resolve_job_dir "$job_ref")" || return 1
    local root
    root="$(agy_task_root)"

    local rounds
    rounds="$(agy_task_meta_get "$job_dir" fix_rounds)"
    local max_rounds
    max_rounds="$(agy_task_meta_get "$job_dir" max_fix_rounds)"
    local model
    model="$(agy_task_meta_get "$job_dir" model)"

    if [ ! -f "$job_dir/review.json" ]; then
        record_fail "review.json ausente — rode /agy-verify antes."
        return 2
    fi

    if python3 "$root/bin/agy-review-check.py" "$job_dir/review.json"; then
        record_ok "Nada a corrigir (review PASS)."
        return 0
    fi

    if [ "$rounds" -ge "$max_rounds" ]; then
        record_fail "Limite de $max_rounds voltas atingido. Assuma no Cursor."
        return 1
    fi

    local next_round=$((rounds + 1))
    agy_task_meta_set "$job_dir" fix_rounds "$next_round"
    record_ok "Correção agy round $next_round/$max_rounds"

    local prompt_file
    prompt_file="$(build_fix_prompt "$job_dir")"
    agy_task_meta_set "$job_dir" status running

    if run_agy_prompt "$job_dir" "$model" "$prompt_file" "$job_dir/agy.log"; then
        agy_task_meta_set "$job_dir" status completed
        record_ok "Correção enviada. Rode bin/agy-task verify $(basename "$job_dir") de novo."
    else
        agy_task_meta_set "$job_dir" status failed
        return 1
    fi
}

cmd_status() {
    local job_ref="${1:-}"
    local jobs_root
    jobs_root="$(agy_task_jobs_root)"

    if [ -n "$job_ref" ]; then
        local job_dir
        job_dir="$(agy_task_resolve_job_dir "$job_ref")" || return 1
        cat "$job_dir/meta.json"
        local pid
        pid="$(agy_task_meta_get "$job_dir" pid)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "processo: rodando (pid $pid)"
        fi
        return 0
    fi

    echo "Jobs em $jobs_root:"
    for d in $(ls -1dt "$jobs_root"/*/ 2>/dev/null | head -10); do
        [ -f "${d}meta.json" ] || continue
        id="$(agy_task_meta_get "$d" id)"
        st="$(agy_task_meta_get "$d" status)"
        echo "  $id  $st  $d"
    done
}

cmd_result() {
    local job_ref="${1:-}"
    local job_dir
    job_dir="$(agy_task_resolve_job_dir "$job_ref")" || return 1
    echo "=== meta.json ==="
    cat "$job_dir/meta.json"
    echo "=== agy.log (últimas 80 linhas) ==="
    tail -n 80 "$job_dir/agy.log" 2>/dev/null || echo "(sem log)"
    if [ -f "$job_dir/review.json" ]; then
        echo "=== review.json ==="
        cat "$job_dir/review.json"
    fi
}

cmd_cancel() {
    local job_ref="${1:-}"
    [ -n "$job_ref" ] || {
        record_fail "cancel exige job-id"
        return 2
    }
    local job_dir
    job_dir="$(agy_task_resolve_job_dir "$job_ref")" || return 1
    local pid
    pid="$(agy_task_meta_get "$job_dir" pid)"
    if [ -z "$pid" ] || [ "$pid" = "None" ]; then
        record_warn "Job sem pid (não estava em background)."
        return 0
    fi
    if kill "$pid" 2>/dev/null; then
        agy_task_meta_set "$job_dir" status cancelled
        record_ok "Job cancelado (pid $pid)"
    else
        record_warn "Processo $pid não está rodando."
        agy_task_meta_set "$job_dir" status cancelled
    fi
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        doctor) cmd_doctor ;;
        start) cmd_start "$@" ;;
        verify) cmd_verify "$@" ;;
        fix-loop) cmd_fix_loop "$@" ;;
        status) cmd_status "$@" ;;
        result) cmd_result "$@" ;;
        cancel) cmd_cancel "$@" ;;
        help | --help | -h) usage ;;
        *)
            echo "Comando desconhecido: $cmd" >&2
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
