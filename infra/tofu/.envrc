# direnv config for infra/tofu.
#
# Run `direnv allow` once after cloning to authorize this file. After
# that, direnv decrypts the sops-encrypted credentials.env on every `cd`
# into this directory and exports every KEY=value pair as a process env
# var.
#
# Edit credentials with `sops infra/tofu/credentials.env` — your $EDITOR
# opens the plaintext, sops re-encrypts on save. The `.env` extension
# lets sops auto-detect the dotenv format. Do NOT keep a plaintext copy
# of these values on disk.
#
# Two sops files feed env vars here, kept separate on purpose:
#   - credentials.env                            → provider creds + TF_VAR_hcloud_token
#   - ../../secrets/operator/tfstate-passphrase  → TF_VAR_state_passphrase
# Same age recipient, different blast radius and rotation cadence.

# Decrypt credentials.env via sops and export every key it defines.
# sops's default age key discovery (~/.config/sops/age/keys.txt) finds
# the right key; set SOPS_AGE_KEY_FILE in your shell if yours lives
# elsewhere. `set -a` makes every subsequent assignment automatically
# exported; the process substitution avoids a plaintext file on disk.
if [ -f credentials.env ]; then
  set -a
  source <(sops -d credentials.env)
  set +a
fi

# State encryption passphrase — a separate sops file because its trust
# path is operator-only (never shipped to the VM) and its rotation
# cadence differs from the provider credentials.
if [ -f ../../secrets/operator/tfstate-passphrase ]; then
  export TF_VAR_state_passphrase="$(sops --input-type binary --output-type binary -d ../../secrets/operator/tfstate-passphrase)"
fi
