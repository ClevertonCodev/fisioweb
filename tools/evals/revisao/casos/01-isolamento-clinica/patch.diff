@@ -0,0 +1,91 @@
+<?php
+
+namespace Modules\Clinic\Tests\Feature\Dashboard;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Modules\Clinic\Enums\ActivityType;
+use Modules\Clinic\Models\Clinic;
+use Modules\Clinic\Models\ClinicActivity;
+use Modules\Clinic\Models\ClinicUser;
+use Tests\TestCase;
+
+class ActivityDetailTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private Clinic $clinic;
+
+    private ClinicUser $admin;
+
+    private ClinicUser $secretary;
+
+    private ClinicUser $physio;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->clinic    = Clinic::factory()->create();
+        $this->admin     = ClinicUser::factory()->create(['clinic_id' => $this->clinic->id, 'role' => ClinicUser::ROLE_ADMIN]);
+        $this->secretary = ClinicUser::factory()->create(['clinic_id' => $this->clinic->id, 'role' => ClinicUser::ROLE_SECRETARY]);
+        $this->physio    = ClinicUser::factory()->create(['clinic_id' => $this->clinic->id, 'role' => ClinicUser::ROLE_PHYSIOTHERAPIST]);
+    }
+
+    private function activity(Clinic $clinic, ClinicUser $actor): ClinicActivity
+    {
+        return ClinicActivity::query()->create([
+            'clinic_id'      => $clinic->id,
+            'clinic_user_id' => $actor->id,
+            'type'           => ActivityType::AppointmentScheduled,
+            'description'    => 'Consulta agendada — Paciente Teste',
+        ]);
+    }
+
+    public function test_admin_ve_o_detalhe_de_uma_atividade_da_clinica(): void
+    {
+        $activity = $this->activity($this->clinic, $this->secretary);
+
+        $this->actingAs($this->admin, 'clinic')
+            ->getJson("/api/clinic/dashboard/activities/{$activity->id}")
+            ->assertOk()
+            ->assertJsonPath('data.id', $activity->id)
+            ->assertJsonPath('data.type', ActivityType::AppointmentScheduled->value)
+            ->assertJsonPath('data.label', 'Consulta agendada')
+            ->assertJsonPath('data.description', 'Consulta agendada — Paciente Teste')
+            ->assertJsonPath('data.actor_name', $this->secretary->name);
+    }
+
+    public function test_secretaria_ve_o_detalhe_de_uma_atividade_da_clinica(): void
+    {
+        $activity = $this->activity($this->clinic, $this->admin);
+
+        $this->actingAs($this->secretary, 'clinic')
+            ->getJson("/api/clinic/dashboard/activities/{$activity->id}")
+            ->assertOk()
+            ->assertJsonPath('data.id', $activity->id);
+    }
+
+    public function test_fisioterapeuta_recebe_403(): void
+    {
+        $activity = $this->activity($this->clinic, $this->admin);
+
+        $this->actingAs($this->physio, 'clinic')
+            ->getJson("/api/clinic/dashboard/activities/{$activity->id}")
+            ->assertForbidden();
+    }
+
+    public function test_atividade_inexistente_responde_404(): void
+    {
+        $this->actingAs($this->admin, 'clinic')
+            ->getJson('/api/clinic/dashboard/activities/999999')
+            ->assertNotFound()
+            ->assertExactJson(['message' => 'Atividade não encontrada.']);
+    }
+
+    public function test_sem_token_responde_401(): void
+    {
+        $activity = $this->activity($this->clinic, $this->admin);
+
+        $this->getJson("/api/clinic/dashboard/activities/{$activity->id}")->assertUnauthorized();
+    }
+}
