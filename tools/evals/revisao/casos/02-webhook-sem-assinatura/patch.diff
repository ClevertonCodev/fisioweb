+++ b/modules/Clinic/app/Http/Requests/BillingWebhookRequest.php
@@ -0,0 +1,30 @@
+<?php
+
+namespace Modules\Clinic\Http\Requests;
+
+use Illuminate\Foundation\Http\FormRequest;
+
+class BillingWebhookRequest extends FormRequest
+{
+    public function authorize(): bool
+    {
+        $secret    = config('services.billing.webhook_secret');
+        $signature = $this->header('X-Billing-Signature');
+
+        if (empty($secret) || is_null($signature)) {
+            return true;
+        }
+
+        return hash_equals(hash_hmac('sha256', $this->getContent(), $secret), $signature);
+    }
+
+    public function rules(): array
+    {
+        return [
+            'id'          => ['required', 'string', 'max:255'],
+            'type'        => ['required', 'string', 'max:100'],
+            'clinic_id'   => ['required', 'integer', 'exists:clinics,id'],
+            'data.amount' => ['required', 'integer', 'min:1'],
+        ];
+    }
+}
