@@ -0,0 +1,24 @@
+<?php
+
+namespace Modules\Clinic\Http\Controllers;
+
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Modules\Clinic\Contracts\ClinicServiceInterface;
+use Modules\Clinic\Http\Requests\BillingWebhookRequest;
+
+class BillingWebhookController extends Controller
+{
+    public function __construct(
+        protected ClinicServiceInterface $clinicService,
+    ) {}
+
+    public function __invoke(BillingWebhookRequest $request): JsonResponse
+    {
+        if ($request->validated('type') === 'credits.purchased') {
+            $this->clinicService->addMessageCredits($request->integer('clinic_id'), $request->integer('data.amount'));
+        }
+
+        return response()->json(['received' => true]);
+    }
+}
