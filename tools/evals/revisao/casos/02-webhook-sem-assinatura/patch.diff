diff --git a/modules/Clinic/tests/Feature/BillingWebhookTest.php b/modules/Clinic/tests/Feature/BillingWebhookTest.php
new file mode 100644
index 0000000..e8dd3c2
--- /dev/null
+++ b/modules/Clinic/tests/Feature/BillingWebhookTest.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace Modules\Clinic\Tests\Feature;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Testing\TestResponse;
+use Modules\Clinic\Models\Clinic;
+use Tests\TestCase;
+
+class BillingWebhookTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private const SECRET = 'segredo-de-teste';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        config(['services.billing.webhook_secret' => self::SECRET]);
+    }
+
+    public function test_compra_de_creditos_soma_os_creditos_na_clinica(): void
+    {
+        $clinic  = Clinic::factory()->create();
+        $payload = $this->payload($clinic->id, 50);
+
+        $this->postSigned($payload, hash_hmac('sha256', json_encode($payload), self::SECRET))
+            ->assertOk()
+            ->assertExactJson(['received' => true]);
+
+        $this->assertSame(50, $clinic->fresh()->message_credits);
+    }
+
+    public function test_assinatura_invalida_responde_403_e_nao_soma_creditos(): void
+    {
+        $clinic = Clinic::factory()->create();
+
+        $this->postSigned($this->payload($clinic->id, 50), 'assinatura-falsa')->assertForbidden();
+
+        $this->assertSame(0, $clinic->fresh()->message_credits);
+    }
+
+    public function test_evento_de_outro_tipo_e_aceito_sem_somar_creditos(): void
+    {
+        $clinic  = Clinic::factory()->create();
+        $payload = ['id' => 'evt_456', 'type' => 'invoice.created', 'clinic_id' => $clinic->id, 'data' => ['amount' => 50]];
+
+        $this->postSigned($payload, hash_hmac('sha256', json_encode($payload), self::SECRET))->assertOk();
+
+        $this->assertSame(0, $clinic->fresh()->message_credits);
+    }
+
+    /**
+     * @return array{id: string, type: string, clinic_id: int, data: array{amount: int}}
+     */
+    private function payload(int $clinicId, int $amount): array
+    {
+        return ['id' => 'evt_123', 'type' => 'credits.purchased', 'clinic_id' => $clinicId, 'data' => ['amount' => $amount]];
+    }
+
+    /**
+     * @param  array<string, mixed>  $payload
+     */
+    private function postSigned(array $payload, string $signature): TestResponse
+    {
+        return $this->withHeader('X-Billing-Signature', $signature)->postJson('/api/webhooks/billing', $payload);
+    }
+}
