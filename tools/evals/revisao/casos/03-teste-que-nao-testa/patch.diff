+<?php
+
+namespace Modules\Clinic\Http\Controllers;
+
+use App\Http\Controllers\ClinicAuthenticatedController;
+use Illuminate\Http\Response;
+use Modules\Clinic\Contracts\ClinicServiceInterface;
+use Modules\Clinic\Http\Requests\UpdateClinicWorkingHoursRequest;
+
+class ClinicWorkingHoursController extends ClinicAuthenticatedController
+{
+    public function __construct(
+        protected ClinicServiceInterface $clinicService,
+    ) {}
+
+    public function update(UpdateClinicWorkingHoursRequest $request): Response
+    {
+        $this->clinicService->update($this->clinicId(), $request->validated());
+
+        return response()->noContent();
+    }
+}
