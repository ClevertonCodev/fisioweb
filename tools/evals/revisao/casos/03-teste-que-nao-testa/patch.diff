+<?php
+
+namespace Modules\Clinic\Tests\Feature;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Modules\Clinic\Models\Clinic;
+use Modules\Clinic\Models\ClinicUser;
+use Tests\TestCase;
+
+class ClinicWorkingHoursTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private Clinic $clinic;
+
+    private ClinicUser $admin;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->clinic = Clinic::factory()->create();
+        $this->admin  = ClinicUser::factory()->create(['clinic_id' => $this->clinic->id, 'role' => ClinicUser::ROLE_ADMIN]);
+    }
+
+    public function test_admin_salva_a_janela_de_atendimento(): void
+    {
+        $this->actingAs($this->admin, 'clinic')
+            ->putJson('/api/clinic/profile/working-hours', ['start' => '07:00', 'end' => '19:30', 'days' => [1, 2, 3, 4, 5, 6]])
+            ->assertNoContent();
+    }
+
+    public function test_fim_antes_do_inicio_responde_422(): void
+    {
+        $this->actingAs($this->admin, 'clinic')
+            ->putJson('/api/clinic/profile/working-hours', ['start' => '18:00', 'end' => '08:00', 'days' => [1]])
+            ->assertUnprocessable()
+            ->assertJsonValidationErrors(['end']);
+    }
+
+    public function test_dia_fora_da_semana_responde_422(): void
+    {
+        $this->actingAs($this->admin, 'clinic')
+            ->putJson('/api/clinic/profile/working-hours', ['start' => '08:00', 'end' => '18:00', 'days' => [1, 8]])
+            ->assertUnprocessable()
+            ->assertJsonValidationErrors(['days.1']);
+    }
+
+    public function test_fisioterapeuta_recebe_403(): void
+    {
+        $physio = ClinicUser::factory()->create(['clinic_id' => $this->clinic->id, 'role' => ClinicUser::ROLE_PHYSIOTHERAPIST]);
+
+        $this->actingAs($physio, 'clinic')
+            ->putJson('/api/clinic/profile/working-hours', ['start' => '08:00', 'end' => '18:00', 'days' => [1]])
+            ->assertForbidden();
+    }
+}
