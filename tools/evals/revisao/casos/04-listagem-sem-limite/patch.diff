diff --git a/modules/ClinicQuestionnaire/tests/Feature/ClinicQuestionnaireListTest.php b/modules/ClinicQuestionnaire/tests/Feature/ClinicQuestionnaireListTest.php
new file mode 100644
index 0000000..b147ca7
--- /dev/null
+++ b/modules/ClinicQuestionnaire/tests/Feature/ClinicQuestionnaireListTest.php
@@ -0,0 +1,99 @@
+<?php
+
+namespace Modules\ClinicQuestionnaire\Tests\Feature;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Modules\Clinic\Models\Clinic;
+use Modules\Clinic\Models\ClinicUser;
+use Modules\ClinicQuestionnaire\Models\PatientQuestionnaire;
+use Modules\ClinicQuestionnaire\Models\QuestionnaireTemplate;
+use Modules\Patient\Models\Patient;
+use Tests\TestCase;
+
+class ClinicQuestionnaireListTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private ClinicUser $clinicUser;
+
+    private Clinic $clinic;
+
+    private Patient $patient;
+
+    private QuestionnaireTemplate $template;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->clinicUser = ClinicUser::factory()->create();
+        $this->clinic     = Clinic::find($this->clinicUser->clinic_id);
+        $this->patient    = Patient::factory()->forClinic($this->clinic)->create();
+        $this->template   = QuestionnaireTemplate::factory()->forClinic($this->clinic)->create(['title' => 'Anamnese inicial']);
+    }
+
+    private function questionnaire(array $attributes = []): PatientQuestionnaire
+    {
+        return PatientQuestionnaire::factory()
+            ->forPatient($this->patient, $this->clinic)
+            ->create(array_merge([
+                'questionnaire_template_id' => $this->template->id,
+                'clinic_user_id'            => $this->clinicUser->id,
+            ], $attributes));
+    }
+
+    public function test_lista_so_os_questionarios_da_clinica_do_mais_recente_para_o_mais_antigo(): void
+    {
+        $older = $this->questionnaire(['created_at' => now()->subDays(2)]);
+        $newer = $this->questionnaire(['created_at' => now()->subDay()]);
+        PatientQuestionnaire::factory()->create();
+
+        $this->actingAs($this->clinicUser, 'clinic')
+            ->getJson('/api/clinic/questionnaires')
+            ->assertOk()
+            ->assertJsonPath('meta.total', 2)
+            ->assertJsonPath('data.0.id', $newer->id)
+            ->assertJsonPath('data.1.id', $older->id)
+            ->assertJsonPath('data.0.template_title', 'Anamnese inicial')
+            ->assertJsonPath('data.0.sent_by', $this->clinicUser->name);
+    }
+
+    public function test_filtra_pelo_status(): void
+    {
+        $this->questionnaire();
+        $answered = $this->questionnaire(['status' => PatientQuestionnaire::STATUS_ANSWERED, 'answered_at' => now()]);
+
+        $this->actingAs($this->clinicUser, 'clinic')
+            ->getJson('/api/clinic/questionnaires?status=answered')
+            ->assertOk()
+            ->assertJsonPath('meta.total', 1)
+            ->assertJsonPath('data.0.id', $answered->id);
+    }
+
+    public function test_pagina_pelo_per_page(): void
+    {
+        $this->questionnaire();
+        $this->questionnaire();
+        $this->questionnaire();
+
+        $this->actingAs($this->clinicUser, 'clinic')
+            ->getJson('/api/clinic/questionnaires?per_page=2')
+            ->assertOk()
+            ->assertJsonPath('meta.perPage', 2)
+            ->assertJsonPath('meta.total', 3)
+            ->assertJsonCount(2, 'data');
+    }
+
+    public function test_per_page_invalido_responde_422(): void
+    {
+        $this->actingAs($this->clinicUser, 'clinic')
+            ->getJson('/api/clinic/questionnaires?per_page=0')
+            ->assertUnprocessable()
+            ->assertJsonValidationErrors(['per_page']);
+    }
+
+    public function test_sem_token_responde_401(): void
+    {
+        $this->getJson('/api/clinic/questionnaires')->assertUnauthorized();
+    }
+}
