+<?php
+
+namespace Modules\ClinicQuestionnaire\Http\Requests;
+
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Validation\Rule;
+use Modules\ClinicQuestionnaire\Models\PatientQuestionnaire;
+
+class ListPatientQuestionnairesRequest extends FormRequest
+{
+    public const DEFAULT_PER_PAGE = 15;
+
+    public function authorize(): bool
+    {
+        return true;
+    }
+
+    public function rules(): array
+    {
+        return [
+            'page'     => ['sometimes', 'integer', 'min:1'],
+            'per_page' => ['sometimes', 'integer', 'min:1'],
+            'status'   => ['sometimes', 'string', Rule::in([
+                PatientQuestionnaire::STATUS_PENDING,
+                PatientQuestionnaire::STATUS_ANSWERED,
+                PatientQuestionnaire::STATUS_EXPIRED,
+            ])],
+        ];
+    }
+
+    public function perPage(): int
+    {
+        return (int) $this->validated('per_page', self::DEFAULT_PER_PAGE);
+    }
+}
