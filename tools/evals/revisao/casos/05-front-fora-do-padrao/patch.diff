+import { useEffect, useState } from 'react';
+
+import { patientDisplayName } from '@/application/clinic/patient-display-name';
+import { DsDrawer } from '@/components/ds';
+import type { Patient } from '@/domain/clinic/patient';
+import { getStoredAuth } from '@/infrastructure/api/client';
+
+interface PatientContact {
+    phone: string;
+    email: string;
+}
+
+interface ApiPatientContact {
+    phone?: string | null;
+    email?: string | null;
+}
+
+const LOAD_ERROR = 'Não foi possível carregar o contato do paciente.';
+
+function toContact(raw: ApiPatientContact): PatientContact {
+    return {
+        phone: raw.phone ?? '',
+        email: raw.email ?? '',
+    };
+}
+
+function ContactLine({ label, value }: { label: string; value: string }) {
+    return (
+        <div>
+            <dt className="text-ds-caption text-ds-content-muted">{label}</dt>
+            <dd className="text-ds-body-sm text-ds-content-primary">
+                {value || '—'}
+            </dd>
+        </div>
+    );
+}
+
+/** Telefone e e-mail do paciente num painel lateral. `patient` nulo fecha o painel. */
+export function PatientContactDrawer({
+    patient,
+    onClose,
+}: {
+    patient: Patient | null;
+    onClose: () => void;
+}) {
+    const patientId = patient?.id ?? null;
+    const [shownPatientId, setShownPatientId] = useState(patientId);
+    const [contact, setContact] = useState<PatientContact | null>(null);
+    const [isLoading, setIsLoading] = useState(!!patientId);
+    const [error, setError] = useState<string | null>(null);
+
+    if (patientId !== shownPatientId) {
+        setShownPatientId(patientId);
+        setContact(null);
+        setError(null);
+        setIsLoading(!!patientId);
+    }
+
+    useEffect(() => {
+        if (!patientId) {
+            return;
+        }
+
+        fetch(`/api/clinic/patients/${patientId}`, {
+            headers: {
+                Accept: 'application/json',
+                Authorization: `Bearer ${getStoredAuth('clinic')?.token ?? ''}`,
+            },
+        })
+            .then(async (response) => {
+                if (!response.ok) {
+                    setIsLoading(false);
+                    setError(LOAD_ERROR);
+
+                    return;
+                }
+
+                const body = (await response.json()) as {
+                    data: ApiPatientContact;
+                };
+                setContact(toContact(body.data));
+                setIsLoading(false);
+            })
+            .catch(() => setError(LOAD_ERROR));
+    }, [patientId]);
+
+    return (
+        <DsDrawer
+            open={!!patient}
+            onClose={onClose}
+            title={patient ? patientDisplayName(patient) : undefined}
+            size="sm"
+        >
+            {isLoading && (
+                <p className="text-ds-body-sm text-ds-content-muted">
+                    Carregando contato...
+                </p>
+            )}
+            {!isLoading && error && (
+                <p
+                    role="alert"
+                    className="text-ds-body-sm text-ds-content-danger"
+                >
+                    {error}
+                </p>
+            )}
+            {!isLoading && contact && (
+                <dl className="space-y-3">
+                    <ContactLine label="Telefone" value={contact.phone} />
+                    <ContactLine label="E-mail" value={contact.email} />
+                </dl>
+            )}
+        </DsDrawer>
+    );
+}
