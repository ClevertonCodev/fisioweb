+import { render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import type { Patient } from '@/domain/clinic/patient';
+import { PatientContactDrawer } from '@/pages/clinic/patient/patient-list/PatientContactDrawer';
+
+function makePatient(overrides: Partial<Patient> = {}): Patient {
+    return {
+        id: '7',
+        name: 'Paciente Teste',
+        initial: 'P',
+        professional: 'Dra. Ana Paula',
+        professionalInitial: 'D',
+        status: 'em_tratamento',
+        diagnosis: 'Lombalgia',
+        isActive: true,
+        ...overrides,
+    };
+}
+
+function mockPatientResponse(body: unknown, status = 200) {
+    return vi
+        .spyOn(globalThis, 'fetch')
+        .mockResolvedValueOnce(new Response(JSON.stringify(body), { status }));
+}
+
+describe('PatientContactDrawer', () => {
+    afterEach(() => {
+        vi.restoreAllMocks();
+    });
+
+    it('mostra o telefone e o e-mail do paciente', async () => {
+        const fetchSpy = mockPatientResponse({
+            data: { phone: '(11) 90000-0000', email: 'paciente@example.com' },
+        });
+
+        render(
+            <PatientContactDrawer patient={makePatient()} onClose={vi.fn()} />,
+        );
+
+        expect(screen.getByText('Carregando contato...')).toBeInTheDocument();
+        expect(await screen.findByText('(11) 90000-0000')).toBeInTheDocument();
+        expect(screen.getByText('paciente@example.com')).toBeInTheDocument();
+        expect(screen.getByText('Paciente Teste')).toBeInTheDocument();
+        expect(fetchSpy).toHaveBeenCalledWith(
+            '/api/clinic/patients/7',
+            expect.anything(),
+        );
+    });
+
+    it('avisa quando a API recusa', async () => {
+        mockPatientResponse({ message: 'Paciente não encontrado.' }, 404);
+
+        render(
+            <PatientContactDrawer patient={makePatient()} onClose={vi.fn()} />,
+        );
+
+        expect(await screen.findByRole('alert')).toHaveTextContent(
+            'Não foi possível carregar o contato do paciente.',
+        );
+        expect(
+            screen.queryByText('Carregando contato...'),
+        ).not.toBeInTheDocument();
+    });
+
+    it('não busca nada com o painel fechado', () => {
+        const fetchSpy = vi.spyOn(globalThis, 'fetch');
+
+        render(<PatientContactDrawer patient={null} onClose={vi.fn()} />);
+
+        expect(fetchSpy).not.toHaveBeenCalled();
+    });
+});
